# =============================================================================
# ABB Plant 3 Gate Verification System — Frontend Environment Configuration
# =============================================================================
#
# In local development, the frontend dev server runs on port 5173/3000 and connects
# to the local Express backend on http://localhost:4000.
#
# In production, when the frontend build is served directly from the backend
# or via reverse proxy, VITE_API_BASE_URL can be left blank (relative path /api).
#
# NOTE: NEVER expose database credentials or passwords in VITE_* variables.
# Database access is strictly backend-only via backend/.env DATABASE_URL.
# =============================================================================

VITE_API_BASE_URL=http://localhost:4000
