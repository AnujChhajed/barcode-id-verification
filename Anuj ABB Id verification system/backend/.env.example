# =============================================================================
# ABB Plant 3 Gate Verification System — Backend Environment Configuration
# Target Database: PostgreSQL 18 (abb_gate_verification)
# =============================================================================

# Server settings
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Database connection URL (Backend-only. Never expose to frontend or commit passwords)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/abb_gate_verification

# CORS origins (Comma-separated list of origins permitted in development)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Security and Sessions
SESSION_COOKIE_NAME=abb_session
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5
